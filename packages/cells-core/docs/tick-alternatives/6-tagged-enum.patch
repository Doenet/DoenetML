+    /// Give each cell the variant of what it holds.
+    pub fn set_tags(&mut self, types: &[crate::program::ValueType]) {
+        use crate::program::ValueType;
+        for (s, &ty) in self.0.iter_mut().zip(types) {
+            let v = *s.get();
+            *s = match ty {
+                ValueType::Number => Value::Number(v),
+                ValueType::Text => Value::Text(v),
+                ValueType::Math => Value::Math(v),
+            };
+        }
+    }

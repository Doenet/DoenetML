 use std::ops::{Index, IndexMut};
 
-/// What one cell is stored as.
-pub type Slot = f64;
+/// What one cell is stored as: a tagged value (decision 6's alternative,
+/// size and tag together).
+pub type Slot = Value;
+
+/// A cell's value with what it is. A missing value stays a NaN number, as
+/// in the core, so values match bit for bit; `Missing` is never made, but
+/// every read matches on the variant.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub enum Value {
+    Number(f64),
+    Text(f64),
+    Math(f64),
+    Missing,
+}
+
+static NAN: f64 = f64::NAN;
+
+impl SlotValue for Value {
+    #[inline(always)]
+    fn new(v: f64) -> Self {
+        Value::Number(v)
+    }
+    #[inline(always)]
+    fn get(&self) -> &f64 {
+        match self {
+            Value::Number(v) | Value::Text(v) | Value::Math(v) => v,
+            Value::Missing => &NAN,
+        }
+    }
+    #[inline(always)]
+    fn get_mut(&mut self) -> &mut f64 {
+        if let Value::Missing = self {
+            *self = Value::Number(f64::NAN);
+        }
+        match self {
+            Value::Number(v) | Value::Text(v) | Value::Math(v) => v,
+            Value::Missing => unreachable!(),
+        }
+    }
+}
 
 /// How a slot holds its value.
 pub trait SlotValue: Copy {

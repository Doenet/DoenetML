+    /// identity instruction, so two cells equal by construction are no
+    /// longer one cell, and what asked whether they were asks this.
+    pub fn source_cell(&self, mut cell: CellIdx) -> CellIdx {
+        loop {
+            let p = self.program.producer[cell as usize];
+            match self.program.instrs.get(p as usize).map(|i| i.op) {
+                Some(crate::program::Op::Id(a)) => cell = a,
+                _ => return cell,
+            }
+        }
+    }

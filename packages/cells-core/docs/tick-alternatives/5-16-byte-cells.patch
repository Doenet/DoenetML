 use std::ops::{Index, IndexMut};
 
-/// What one cell is stored as.
-pub type Slot = f64;
+/// What one cell is stored as: 16 bytes, its value and padding, with no
+/// tag (decision 5's alternative, size alone).
+pub type Slot = Padded;
+
+#[repr(C)]
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct Padded {
+    v: f64,
+    _pad: f64,
+}
+
+impl SlotValue for Padded {
+    #[inline(always)]
+    fn new(v: f64) -> Self {
+        Padded { v, _pad: 0.0 }
+    }
+    #[inline(always)]
+    fn get(&self) -> &f64 {
+        &self.v
+    }
+    #[inline(always)]
+    fn get_mut(&mut self) -> &mut f64 {
+        &mut self.v
+    }
+}
 
 /// How a slot holds its value.
 pub trait SlotValue: Copy {

+pub type Slot = Box<f64>;
+
+/// Whether the values are allocated in a shuffled order, so the heap
+/// scatters them as it would objects made over a session, rather than in
+/// cell order, which lays them nearly side by side.
+const SHUFFLE: bool = true;
+
+impl SlotValue for Box<f64> {
+    #[inline(always)]
+    fn new(v: f64) -> Self {
+        Box::new(v)
+    }
+    #[inline(always)]
+    fn get(&self) -> &f64 {
+        self
+    }
+    #[inline(always)]
+    fn get_mut(&mut self) -> &mut f64 {
+        self
+    }
+}
+
+/// Allocate one box per value, in a fixed shuffled order when `SHUFFLE`.
+fn allocate(values: impl Fn(usize) -> f64, n: usize) -> Vec<Slot> {
+    let mut order: Vec<usize> = (0..n).collect();
+    if SHUFFLE {
+        let mut x: u64 = 0x9e37_79b9_7f4a_7c15;
+        for i in (1..n).rev() {
+            x ^= x << 13;
+            x ^= x >> 7;
+            x ^= x << 17;
+            order.swap(i, (x % (i as u64 + 1)) as usize);
+        }
+    }
+    let mut slots: Vec<Option<Slot>> = (0..n).map(|_| None).collect();
+    for i in order {
+        slots[i] = Some(Box::new(values(i)));
+    }
+    slots.into_iter().map(Option::unwrap).collect()
+}
 

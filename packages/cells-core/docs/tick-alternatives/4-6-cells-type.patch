diff --git a/packages/cells-core/crates/cells-core/src/cells.rs b/packages/cells-core/crates/cells-core/src/cells.rs
new file mode 100644
index 0000000..e5c441e
--- /dev/null
+++ b/packages/cells-core/crates/cells-core/src/cells.rs
@@ -0,0 +1,106 @@
+//! The document's cells as a type of their own, so what a cell is can be
+//! changed in one place: the alternatives to decisions 4 to 6 of
+//! `docs/tick-design-decisions.md`. Indexed by cell, it reads and writes an
+//! `f64` whatever a slot holds.
+
+use std::ops::{Index, IndexMut};
+
+/// What one cell is stored as.
+pub type Slot = f64;
+
+/// How a slot holds its value.
+pub trait SlotValue: Copy {
+    fn new(v: f64) -> Self;
+    fn get(&self) -> &f64;
+    fn get_mut(&mut self) -> &mut f64;
+}
+
+impl SlotValue for f64 {
+    #[inline(always)]
+    fn new(v: f64) -> Self {
+        v
+    }
+    #[inline(always)]
+    fn get(&self) -> &f64 {
+        self
+    }
+    #[inline(always)]
+    fn get_mut(&mut self) -> &mut f64 {
+        self
+    }
+}
+
+/// Every cell of a document, in cell order.
+#[derive(Clone, Debug, Default, PartialEq)]
+pub struct Cells(Vec<Slot>);
+
+impl Cells {
+    pub fn from_values(values: Vec<f64>) -> Self {
+        Cells(values.into_iter().map(Slot::new).collect())
+    }
+
+    pub fn filled(value: f64, n: usize) -> Self {
+        Cells(vec![Slot::new(value); n])
+    }
+
+    pub fn get(&self, i: usize) -> Option<&f64> {
+        self.0.get(i).map(SlotValue::get)
+    }
+
+    pub fn len(&self) -> usize {
+        self.0.len()
+    }
+
+    pub fn is_empty(&self) -> bool {
+        self.0.is_empty()
+    }
+
+    pub fn iter(&self) -> impl Iterator<Item = f64> + '_ {
+        self.0.iter().map(|s| *s.get())
+    }
+
+    pub fn to_vec(&self) -> Vec<f64> {
+        self.iter().collect()
+    }
+
+    /// The cells `start..start + n`, as values.
+    pub fn values(&self, start: usize, n: usize) -> Vec<f64> {
+        self.0[start..start + n].iter().map(|s| *s.get()).collect()
+    }
+
+    /// Write `values` to the cells from `start`.
+    #[inline(always)]
+    pub fn write(&mut self, start: usize, values: &[f64]) {
+        for (s, &v) in self.0[start..start + values.len()].iter_mut().zip(values) {
+            *s.get_mut() = v;
+        }
+    }
+
+    /// Where the slots begin, for the wasm binding's view of them.
+    pub fn as_ptr(&self) -> *const Slot {
+        self.0.as_ptr()
+    }
+}
+
+impl Index<usize> for Cells {
+    type Output = f64;
+    #[inline(always)]
+    fn index(&self, i: usize) -> &f64 {
+        self.0[i].get()
+    }
+}
+
+impl IndexMut<usize> for Cells {
+    #[inline(always)]
+    fn index_mut(&mut self, i: usize) -> &mut f64 {
+        self.0[i].get_mut()
+    }
+}
+
+impl<'a> IntoIterator for &'a Cells {
+    type Item = f64;
+    type IntoIter = std::iter::Map<std::slice::Iter<'a, Slot>, fn(&Slot) -> f64>;
+    fn into_iter(self) -> Self::IntoIter {
+        self.0.iter().map(|s| *s.get())
+    }
+}

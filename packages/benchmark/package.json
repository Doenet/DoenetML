    "version": "*",
    "license": "AGPL-3.0-or-later",
    "homepage": "https://github.com/Doenet/DoenetML#readme",
    "private": true,
    "repository": "github:Doenet/DoenetML",
    "scripts": {
        "fixtures": "node scripts/list-fixtures.mjs",
        "test": "echo \"No tests\"",
        "node": "node src/run.mjs",
        "bundle": "node src/bundle.mjs",
        "build:rust-viewer": "vite build -c browser/rust-viewer/vite.config.ts",

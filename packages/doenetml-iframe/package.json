{
    "name": "@doenet/doenetml-iframe",
    "type": "module",
    "description": "A renderer for DoenetML contained in an iframe",
    "version": "0.7.24",
    "license": "AGPL-3.0-or-later",
    "homepage": "https://github.com/Doenet/DoenetML#readme",
    "private": true,
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Doenet/DoenetML.git"
    },
    "files": [
        "/dist"
    ],
    "exports": {
        ".": {
            "import": "./dist/component/index.js"
        },
        "./*": {
            "import": "./dist/component/*"
        }
    },
    "//": [
        "`build` is a wireit script, not `npm run a && npm run b && npm run c`.",
        "Chaining npm runs starts a separate wireit invocation per link, and each",
        "one resolves the shared dependency chain (../doenetml, and through it",
        "../math and ../utils) on its own. Wireit serialises a given script only",
        "against itself, so one invocation would clean and rebuild",
        "packages/math/dist while a vite build in a sibling invocation was reading",
        "it — surfacing as `Failed to resolve entry for package \"math-expressions\"`",
        "or `\"@doenet/utils\"` from whichever build lost the race. That is what broke",
        "Build Docs in CI, and the victim moved from run to run. Keeping this one",
        "graph lets wireit order the whole thing."
    ],
    "scripts": {
        "dev": "npm run build:iframe-viewer && npm run build:iframe-editor && vite",
        "build": "wireit",
        "build:component": "wireit",
        "build:iframe-viewer": "wireit",
        "build:iframe-editor": "wireit",
        "publish": "npm run build && node ../../.github/scripts/npm-publish-with-retry.mjs dist/component",
        "test": "echo \"No tests \"",
        "test-cypress": "cypress open --component",
        "test-cypress-all": "cypress run --component -b 'chrome' --config video=false --headless"
    },
    "wireit": {
        "build": {
            "dependencies": [
                "build:component"
            ]
        },
        "build:iframe-viewer": {
            "command": "vite -c vite.config-iframe-viewer.ts build",
            "files": [
                "src/iframe-viewer-index.ts",
                "vite.config-iframe-viewer.ts",
                "tsconfig.json"
            ],
            "output": [
                "dist/iframe-viewer/*"
            ]
        },
        "build:iframe-editor": {
            "command": "vite -c vite.config-iframe-editor.ts build",
            "files": [
                "src/iframe-editor-index.ts",
                "vite.config-iframe-editor.ts",
                "tsconfig.json"
            ],
            "output": [
                "dist/iframe-editor/*"
            ]
        },
        "build:component": {
            "command": "vite build",
            "files": [
                "src/**/*.ts",
                "src/**/*.tsx",
                "tsconfig.json",
                "vite.config.ts",
                "package.json",
                "dist/iframe-viewer/*",
                "dist/iframe-editor/*"
            ],
            "output": [
                "dist/component/*"
            ],
            "dependencies": [
                "../doenetml:build",
                "build:iframe-viewer",
                "build:iframe-editor"
            ]
        }
    },
    "peerDependencies": {
        "react": "^19.2.3",
        "react-dom": "^19.2.3",
        "better-react-mathjax": "^3.0.0"
    },
    "dependencies": {},
    "devDependencies": {}
}

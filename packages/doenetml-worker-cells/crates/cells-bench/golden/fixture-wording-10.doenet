<p><conditionalContent name="c4"><case condition="$n > 0">Positive: <math name="m">5x+1</math> and <number name="k">4</number>.</case><case condition="$n < 0">Negative: <math name="m">x-5</math> and <number name="k">-4</number>.</case><else>Zero: <math name="m">0</math> and <number name="k">0</number>.</else></conditionalContent></p><p>$c4.m, $c4.k</p>
<p><conditionalContent name="c5"><case condition="$n > 0">Positive: <math name="m">6x+1</math> and <number name="k">5</number>.</case><case condition="$n < 0">Negative: <math name="m">x-6</math> and <number name="k">-5</number>.</case><else>Zero: <math name="m">0</math> and <number name="k">0</number>.</else></conditionalContent></p><p>$c5.m, $c5.k</p>
<p><conditionalContent name="c6"><case condition="$n > 0">Positive: <math name="m">7x+1</math> and <number name="k">6</number>.</case><case condition="$n < 0">Negative: <math name="m">x-7</math> and <number name="k">-6</number>.</case><else>Zero: <math name="m">0</math> and <number name="k">0</number>.</else></conditionalContent></p><p>$c6.m, $c6.k</p>
<p><conditionalContent name="c7"><case condition="$n > 0">Positive: <math name="m">8x+1</math> and <number name="k">7</number>.</case><case condition="$n < 0">Negative: <math name="m">x-8</math> and <number name="k">-7</number>.</case><else>Zero: <math name="m">0</math> and <number name="k">0</number>.</else></conditionalContent></p><p>$c7.m, $c7.k</p>
<p><conditionalContent name="c8"><case condition="$n > 0">Positive: <math name="m">9x+1</math> and <number name="k">8</number>.</case><case condition="$n < 0">Negative: <math name="m">x-9</math> and <number name="k">-8</number>.</case><else>Zero: <math name="m">0</math> and <number name="k">0</number>.</else></conditionalContent></p><p>$c8.m, $c8.k</p>

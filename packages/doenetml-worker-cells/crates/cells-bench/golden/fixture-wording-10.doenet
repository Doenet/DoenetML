<numberInput name="n" value="1"/>
<graph name="g"><point name="p0" x="1" y="2"/></graph>
<p><conditionalContent name="c0"><case condition="$n > 0">Positive: <math name="m">1x+1</math> and <number name="k">0</number>.</case><case condition="$n < 0">Negative: <math name="m">x-1</math> and <number name="k">-0</number>.</case><else>Zero: <math name="m">0</math> and <number name="k">0</number>.</else></conditionalContent></p><p>$c0.m, $c0.k</p>
<p><conditionalContent name="c1"><case condition="$n > 0">Positive: <math name="m">2x+1</math> and <number name="k">1</number>.</case><case condition="$n < 0">Negative: <math name="m">x-2</math> and <number name="k">-1</number>.</case><else>Zero: <math name="m">0</math> and <number name="k">0</number>.</else></conditionalContent></p><p>$c1.m, $c1.k</p>

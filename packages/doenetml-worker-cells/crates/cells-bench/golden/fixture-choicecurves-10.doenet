<numberInput name="n" value="1"/>
<graph name="g"><point name="p0" x="1" y="1"/></graph>
<conditionalContent name="cc"><case condition="$n = 1"><graph><function>$p0.x x^2 + 0</function><function>$p0.x x^2 + 1</function><function>$p0.x x^2 + 2</function><function>$p0.x x^2 + 3</function><function>$p0.x x^2 + 4</function><function>$p0.x x^2 + 5</function><function>$p0.x x^2 + 6</function><function>$p0.x x^2 + 0</function><function>$p0.x x^2 + 1</function><function>$p0.x x^2 + 2</function></graph></case><case condition="$n = 2"><graph><function>$p0.x x^2 + 0</function><function>$p0.x x^2 + 2</function><function>$p0.x x^2 + 4</function><function>$p0.x x^2 + 6</function><function>$p0.x x^2 + 1</function><function>$p0.x x^2 + 3</function><function>$p0.x x^2 + 5</function><function>$p0.x x^2 + 0</function><function>$p0.x x^2 + 2</function><function>$p0.x x^2 + 4</function></graph></case><case condition="$n = 3"><graph><function>$p0.x x^2 + 0</function><function>$p0.x x^2 + 3</function><function>$p0.x x^2 + 6</function><function>$p0.x x^2 + 2</function><function>$p0.x x^2 + 5</function><function>$p0.x x^2 + 1</function><function>$p0.x x^2 + 4</function><function>$p0.x x^2 + 0</function><function>$p0.x x^2 + 3</function><function>$p0.x x^2 + 6</function></graph></case><else><graph><function>$p0.x x^2 + 0</function><function>$p0.x x^2 + 4</function><function>$p0.x x^2 + 1</function><function>$p0.x x^2 + 5</function><function>$p0.x x^2 + 2</function><function>$p0.x x^2 + 6</function><function>$p0.x x^2 + 3</function><function>$p0.x x^2 + 0</function><function>$p0.x x^2 + 4</function><function>$p0.x x^2 + 1</function></graph></else></conditionalContent>

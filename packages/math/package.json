{
    "name": "@doenet/math",
    "type": "module",
    "description": "The single seam through which DoenetML reaches math-expressions: the Rust core compiled to WASM, inlined and re-exported behind the legacy API.",
    "version": "1.0.0",
    "license": "AGPL-3.0-or-later",
    "homepage": "https://github.com/Doenet/DoenetML#readme",
    "private": true,
    "repository": "github:Doenet/DoenetML",
    "files": [
        "/dist"
    ],
    "exports": {
        ".": {
            "import": "./dist/index.js",
            "types": "./dist/index.d.ts"
        },
        "./engine-rust": {
            "import": "./dist/engine-rust.js"
        }
    },
    "scripts": {
        "watch": "vite build --watch",
        "test": "wireit",
        "build:wasm": "wireit",
        "build": "wireit"
    },
    "wireit": {
        "test": {
            "command": "vitest run",
            "files": [
                "test/**/*.ts",
                "vitest.config.ts"
            ],
            "output": [],
            "dependencies": [
                "build"
            ]
        },
        "build:wasm": {
            "command": "node scripts/build-wasm.mjs",
            "files": [
                "scripts/build-wasm.mjs",
                "../../vendor/math-expressions/Cargo.toml",
                "../../vendor/math-expressions/Cargo.lock",
                "../../vendor/math-expressions/packages/math-expressions-rs/Cargo.toml",
                "../../vendor/math-expressions/packages/math-expressions-rs/src/**",
                "../../vendor/math-expressions/packages/math-expressions-rs-wasm/Cargo.toml",
                "../../vendor/math-expressions/packages/math-expressions-rs-wasm/build-wasm.sh",
                "../../vendor/math-expressions/packages/math-expressions-rs-wasm/src-rust/**"
            ],
            "output": [
                "src/generated/**"
            ],
            "clean": false
        },
        "build": {
            "command": "vite build",
            "files": [
                "src/**/*.ts",
                "vite.config.ts",
                "tsconfig.json",
                "../../vendor/math-expressions/packages/math-expressions-js-compat/lib/**/*.ts",
                "../../vendor/math-expressions/packages/math-expressions-rs-wasm/src-js/**/*.ts",
                "src/generated/**"
            ],
            "output": [
                "dist/**/*.js",
                "dist/**/*.map",
                "dist/**/*.d.ts"
            ],
            "dependencies": [
                "build:wasm"
            ],
            "clean": true
        }
    },
    "dependencies": {
        "mathjs": "^15.2.0"
    }
}

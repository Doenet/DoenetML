## The accessibility status button

editor-accessibility-title =
    { $status ->
        [violations] Es isch en Verstoss gäge WCAG AA gfunde worde. Klicke, zum de Bricht zur Barrierefreiheit { $action ->
            [close] zuemache
           *[open] uufmache
        }.
        [advisories] Klicke, zum de Bricht zur Barrierefreiheit { $action ->
            [close] zuemache
           *[open] uufmache
        }. Es sind kei WCAG-AA-Verstöss gfunde worde, aber es git wiiteri Empfählige zur Barrierefreiheit.
       *[clean] Klicke, zum de Bricht zur Barrierefreiheit { $action ->
            [close] zuemache
           *[open] uufmache
        }. Es sind kei Probläm mit de Barrierefreiheit gfunde worde.
    }

editor-accessibility-label =
    { $status ->
        [violations] Es isch en Verstoss gäge WCAG AA gfunde worde. Es sind { $count ->
            [one] { $count } WCAG-AA-Verstoss
           *[other] { $count } WCAG-AA-Verstöss
        } gfunde worde. Klicke, zum de Bricht zur Barrierefreiheit { $action ->
            [close] zuemache
           *[open] uufmache
        }.
        [advisories] Es sind kei WCAG-AA-Verstöss gfunde worde. Es sind { $count ->
            [one] { $count } wiiteri Empfählig zur Barrierefreiheit
           *[other] { $count } wiiteri Empfählige zur Barrierefreiheit
        } gfunde worde. Klicke, zum de Bricht zur Barrierefreiheit { $action ->
            [close] zuemache
           *[open] uufmache
        }.
       *[clean] Es sind kei WCAG-AA-Verstöss gfunde worde. Klicke, zum de Bricht zur Barrierefreiheit { $action ->
            [close] zuemache
           *[open] uufmache
        }.
    }

editor-accessibility-badge = WCAG



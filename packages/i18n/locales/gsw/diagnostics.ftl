parse-tag-missing-close-tag = Ungültigs DoenetML: De Tag `{ $tag }` hät kein Schlusstag. Erwartet isch en sälbschtschliessende Tag oder en `</{ $tagName }>`-Tag.

parse-tag-error = Ungültigs DoenetML: Fähler im Tag `<{ $tagName }>`

parse-attribute-missing-value = Ungültigs DoenetML: Em ungültige Attribut `{ $attribute }` fählt schiins en Wärt.

parse-attribute-invalid = Ungültigs DoenetML: Ungültigs Attribut `{ $attribute }`


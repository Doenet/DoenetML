parse-self-closing-tag-not-closed = Ungültigs DoenetML: De Tag `{ $tag }` isch nöd gschlosse worde (`/>` fählt schiins).

parse-tag-invalid-attributes = Ungültigs DoenetML: De Tag `{ $tag }` isch nöd gültig. Villicht händ d Attribut Fähler.

parse-close-tag-name-missing = Ungültigs DoenetML: Es isch en Schlusstag ohni Tag-Name gfunde worde, zum Bispil `</`

parse-attribute-value-unquoted = Attributwärt müend i Aaführigszeiche stoo: `{ $attribute }="{ $value }"`

parse-close-tag-without-open-tag = Ungültigs DoenetML: De Schlusstag `{ $tag }` isch gfunde worde, aber es git kein zueghörige Öffnigstag

parse-close-tag-mismatched = Ungültigs DoenetML: De Schlusstag passt nöd. Erwartet isch `</{ $expected }>`. Gfunde isch `{ $found }`


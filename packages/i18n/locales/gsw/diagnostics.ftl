# Swiss German (Schwiizertüütsch) diagnostics. Translated from
# `locales/en/diagnostics.ftl`, which is the source of truth: `lint:i18n`
# rejects a key that does not exist there, and reports a key that exists there
# but not here as missing coverage.
#
# UNREVIEWED SEED. Machine-generated, pending review by a speaker (#1521).
# Correct anything here freely; nothing in it was written by a translator.
#
# **Orthography.** The Dieth-Schreibung, the convention Swiss German publishing
# uses: long vowels written double («Siite», «wiiss», «Fääler», «Chreis»), and
# **no ß anywhere** — «ss» in every position. That is the sharpest visible
# break from `locales/de`; see `chrome.ftl` for the full note.
#
# **This is a written standard over a spread of dialects**, and this file uses
# the Zurich-based koine rather than Bernese, Basel or Valais — the trade
# `locales/sc` and `locales/rm` already record. A deployment that wants a
# particular dialect supplies its own catalog as `localeResources`.
#
# **Do not edit this file toward Standard German**: «nöd» for «nicht», «chan»
# for «kann», «gseh» for «sehen», «Fähler» for «Fehler», «Siite» for «Seite»,
# «lueg» for «schau» are the catalog, not mistakes.
#
# **There is no simple past.** Swiss German lost the preterite entirely and
# uses the perfect throughout, which is why every past-tense sentence here
# reads as a perfect: «hät nöd chöne bestimmt werde», never a preterite.
#
# **Number.** CLDR *does* have plural rules for `gsw` — `one` and `other` — so
# a category branch is selected by Swiss German's own rules, unlike the six
# catalogs of this batch CLDR has no data for and where everything falls
# through to `other`. There is no `zero`, `two`, `few` or `many` category, so
# never write one; the branch is written wherever the noun actually changes.
#
# Attribute names, element names and every other DoenetML identifier —
# `through`, `endpoint`, `midpointOffset`, `numDimensions`, `styleNumber`,
# `selectFromSequence`, `<answer>`, `maxNumAttempts`, `sectionWideCheckWork` —
# are part of the language, not prose, and stay in English exactly as written.
# So does anything quoted back from the author's own source, and so do
# `WCAG AA`, `DoenetML`, `PreFigure`, `prefigure`, `XML`, `mathjs` and `Dast`,
# which are names. Every **symbolic** selector — `$type`, `$mode`, `$reason`,
# `$context`, `$suggestion`, `$alternative`, `$fallback`, `$expected`,
# `$labelKind`, `$isList`, `$componentType` — is kept byte for byte from
# English, keys included.


## `<lineSegment>`

line-segment-attributes-ignored-with-endpoints =
    { $attributesCount ->
        [one] { $attributes } wird ignoriert, wänn zwee Ändpünkt aagäh sind
       *[other] { $attributes } wärded ignoriert, wänn zwee Ändpünkt aagäh sind
    }

line-segment-attributes-ignored-with-endpoint-and-midpoint =
    { $attributesCount ->
        [one] { $attributes } wird ignoriert, wänn en Ändpunkt und en Mittelpunkt beedi aagäh sind
       *[other] { $attributes } wärded ignoriert, wänn en Ändpunkt und en Mittelpunkt beedi aagäh sind
    }

line-segment-midpoint-offset-without-midpoint = midpointOffset hät kei Wirkig ohni en Mittelpunkt

## `<line>`

line-points-undetermined-dimensions = Grad dur Pünkt mit unbestimmte Dimensione.

line-points-too-few-dimensions = D Grad mues dur Pünkt mit mindeschtens zwo Dimensione goo.

line-points-depend-on-variables = D Grad goot dur Pünkt, wo vo Variable abhänged: { $variables }.

line-equation-invalid-format = Ungültigs Format für d Gliichig vo de Grad i de Variable { $variable1 } und { $variable2 }.

## `<ray>`

ray-overprescribed-through = De Strahl isch dur through, endpoint und direction festgleit.  Es aagäh through wird ignoriert.

ray-dimension-mismatch = numDimensions passt im Strahl nöd zäme.

## `<vector>`

vector-overprescribed-head = De Vektor isch dur head, tail und displacement festgleit.  Es aagäh head wird ignoriert.

vector-dimension-mismatch = numDimensions passt im Vektor nöd zäme.

## Attracting and constraining

attract-to-without-nearest-point = Cha nöd uf es `<{ $component }>` aazoge werde, wil s kei nearestPoint-Zuestandsvariable hät.

constrain-to-without-nearest-point = Cha nöd uf es `<{ $component }>` iigschränkt werde, wil s kei nearestPoint-Zuestandsvariable hät.

constrain-to-interior-without-nearest-point = Cha nöd uf s Inneri vom ene `<{ $component }>` iigschränkt werde, wil s kei nearestPoint-Zuestandsvariable hät.

## `<choiceInput>`

choice-input-label-position-ignored = labelPosition wird bi eme nöd-inline choiceInput ignoriert

## Ordering children by index

choice-input-indices-count-mismatch = D Indize für choiceInput wärded ignoriert, wil d Aazahl Indize nöd zur Aazahl vo de Uuswahl-Chinder passt.

pretzel-indices-count-mismatch = D Indize für problem wärded ignoriert, wil d Aazahl Indize nöd zur Aazahl vo de problem-Chinder passt.

shuffle-indices-count-mismatch = D Indize für shuffle wärded ignoriert, wil d Aazahl Indize nöd zur Aazahl vo de Komponänte passt.

indices-ignored-out-of-range = D Indize für { $component } wärded ignoriert, wil es Indize usserhalb vom Beriich hät.

pretzel-indices-repeated = D Indize für pretzel wärded ignoriert, wil es Indize doppelt hät.

pretzel-circuit-first-index = D Indize für pretzel im circuit-Modus wärded ignoriert, wil de erscht Index 1 sii mues.

## `<shuffle>` and `<sort>`

string-children-need-type = Damit `<{ $component }>` mit Zeichechette-Chinder funktioniert, mues es `type`-Attribut aagäh sii.

invalid-type-defaulting-to-math = Ungültige type { $type } für d Komponänte { $component }. Mues eis vo math, text, number oder boolean sii. Es wird math gnoh.

string-not-valid-component-to-arrange = D Zeichechette "{ $value }" isch kei gültigi Komponänte für { $component }. Wird ignoriert.

## Types and variables

invalid-type-defaulting-to-number = Ungültige type { $type }, de Typ wird uf number gsetzt.

invalid-variable-value = Ungültige Wärt vo ere Variable: `{ $value }`

## Variants

variant-index-must-be-number = De Variante-Index { $index } mues e Zahl sii

variant-index-must-be-integer = De Variante-Index { $index } mues e ganzi Zahl sii

## `<sideBySide>`

side-by-side-absolute-widths = `<{ $component }>` isch für absoluti Mäss nöd umgsetzt. D Breiti wird uf relativ gsetzt.

side-by-side-absolute-margins = `<{ $component }>` isch für absoluti Mäss nöd umgsetzt. D Ränder wärded uf relativ gsetzt.

side-by-side-no-block-child = Ungültigs `<{ $component }>`: es mues mindeschtens es Block-Chind ha.

## `<label>`

label-for-ignored-on-graphical = S `for`-Attribut a mene grafische `<label>` wird ignoriert.

label-for-must-resolve-to-one = S `for`-Attribut a mene `<label>` mues genau ei Komponänte ergäh.

label-for-unresolved = S `for`-Attribut a mene `<label>` hät nöd chöne uf e Komponänte ufglöst werde.

label-for-answer-with-authored-inputs = S `for`-Attribut a mene `<label>` verwiist uf es `<answer>` mit uusdrücklich gschribne Iigabe; verwiis direkt uf d Iigab.

label-for-answer-without-input = S `for`-Attribut a mene `<label>` verwiist uf es `<answer>` ohni Iigab zum Bschrifte.

label-for-must-reference-input-or-answer = S `for`-Attribut a mene `<label>` mues uf e Iigab oder es answer verwiise.

## Accessibility

accessibility-short-description-or-decorative = Für d Barrierefreiheit mues `<{ $component }>` entweder e churzi Bschriibig ha oder als dekorativ aagäh sii.

accessibility-video-short-description = Für d Barrierefreiheit mues `<video>` e churzi Bschriibig ha.

accessibility-input-short-description-or-label = Für d Barrierefreiheit mues `<{ $component }>` e churzi Bschriibig oder es Label ha.

accessibility-answer-input-short-description-or-label = Für d Barrierefreiheit mues es `<answer>`, wo e Iigab erstellt, e churzi Bschriibig oder es Label ha.

accessibility-short-description-contains-math = Churzi Bschriibige söttet kei Mathe-Komponänte wie `<{ $component }>` dinn ha. Schriib d Mathematik mit Wört uus.

accessibility-section-title-insufficient-contrast =
    { $mode ->
        [dark] { $colorName } hät z wenig Kontrascht für de Täxt vom Abschnitts-Titel (dunkle Modus) ({ NUMBER($ratio, minimumFractionDigits: 2, maximumFractionDigits: 2) }:1; verlangt mindeschtens { $threshold }:1).
       *[other] { $colorName } hät z wenig Kontrascht für de Täxt vom Abschnitts-Titel ({ NUMBER($ratio, minimumFractionDigits: 2, maximumFractionDigits: 2) }:1; verlangt mindeschtens { $threshold }:1).
    }

## `<circle>`

circle-through-points-non-numerical = En `<circle>` dur { $count } Pünkt isch nöd umgsetzt für de Fall, wo d Pünkt kei numerischi Wärt händ.

circle-too-many-through-points = En Chreis dur meh als 3 Pünkt cha nöd brächnet werde.

circle-overprescribed-radius-center-points = En Chreis mit aagähem Radius, Mittelpunkt und Durchgangspünkt cha nöd brächnet werde.

circle-center-with-multiple-points = En Chreis mit aagähem Mittelpunkt dur meh als 1 Punkt cha nöd brächnet werde.

circle-radius-too-small = De Chreis cha nöd brächnet werde: wil de Abstand zwüsched de zwee Pünkt { $distance } isch, isch de aagäh Radius { $radius } z chlii.

circle-radius-with-many-points = En Chreis dur meh als zwee Pünkt mit eme aagähne Radius cha nöd erstellt werde.

circle-invalid-center-or-through-points = Ungültige Mittelpunkt oder ungültigi Durchgangspünkt vom Chreis.

circle-radius-center-with-multiple-points = De Radius vom ene Chreis mit aagähem Mittelpunkt dur meh als 1 Punkt cha nöd brächnet werde.

circle-change-radius-non-numerical = De Radius vom ene Chreis mit nöd-numerische Durchgangspünkt cha nöd gänderet werde

circle-radius-with-points-non-numerical = En Chreis dur meh als ei Punkt mit eme aagähne Radius cha nöd erstellt werde, wänn kei numerischi Wärt do sind.

circle-change-center-non-numerical = S Ändere vom Mittelpunkt vom ene Chreis dur Pünkt ohni numerischi Wärt isch nöd umgsetzt.

## `<function>`

function-domain-insufficient-dimensions =
    { $intervals ->
        [one] Z wenig Dimensione für de Definitionsberiich vo de Funktion. De Beriich hät { $intervals } Intervall, aber d Funktion hät { $inputs ->
            [one] { $inputs } Iigab
           *[other] { $inputs } Iigabe
        }.
       *[other] Z wenig Dimensione für de Definitionsberiich vo de Funktion. De Beriich hät { $intervals } Intervall, aber d Funktion hät { $inputs ->
            [one] { $inputs } Iigab
           *[other] { $inputs } Iigabe
        }.
    }

function-domain-invalid-format = Ungültigs Format für de Definitionsberiich vo de Funktion.

function-ignoring-non-numerical =
    { $type ->
        [maximum] S nöd-numerische Maximum vo de Funktion wird ignoriert.
        [minimum] S nöd-numerische Minimum vo de Funktion wird ignoriert.
        [extremum] S nöd-numerische Extremum vo de Funktion wird ignoriert.
        [point] De nöd-numerisch Punkt vo de Funktion wird ignoriert.
        [slope] D nöd-numerischi Steigig vo de Funktion wird ignoriert.
       *[other] S nöd-numerische { $type } vo de Funktion wird ignoriert.
    }

function-ignoring-empty =
    { $type ->
        [maximum] S leere Maximum vo de Funktion wird ignoriert.
        [minimum] S leere Minimum vo de Funktion wird ignoriert.
        [extremum] S leere Extremum vo de Funktion wird ignoriert.
        [point] De leer Punkt vo de Funktion wird ignoriert.
       *[other] S leere { $type } vo de Funktion wird ignoriert.
    }

function-points-too-close = D Funktion hät zwee Pünkt, wo z nooch binenand ligged. D Funktion cha nöd definiert werde.

function-iterates-input-output-mismatch =
    { $inputs ->
        [one] Iterierte vo ere Funktion sind nu möglich, wänn d Aazahl Iigabe glich isch wie d Aazahl Uusgabe. Die Funktion hät { $inputs } Iigab und { $outputs ->
            [one] { $outputs } Uusgab
           *[other] { $outputs } Uusgabe
        }.
       *[other] Iterierte vo ere Funktion sind nu möglich, wänn d Aazahl Iigabe glich isch wie d Aazahl Uusgabe. Die Funktion hät { $inputs } Iigabe und { $outputs ->
            [one] { $outputs } Uusgab
           *[other] { $outputs } Uusgabe
        }.
    }


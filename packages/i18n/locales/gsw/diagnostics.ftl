sequence-invalid-length = Ungültigi Läng vo de Folg.  Mues e nöd-negativi ganzi Zahl sii.

sequence-invalid-step = Ungültige Schritt vo de Folg.  Mues e Zahl sii für e Folg vom Typ { $type }.

sequence-invalid-endpoint-number = Ungültigs "{ $attribute }" vo ere Zahlefolg.  Mues e Zahl sii.

sequence-invalid-endpoint-letters = Ungültigs "{ $attribute }" vo ere Buechstabefolg.  Mues e Buechstabe-Kombination sii.

sequence-invalid-endpoint = Ungültigs "{ $attribute }" vo de Folg.

select-from-sequence-coprime-not-numbers = coprime wird ignoriert, wil kei Zahle uusgwählt wärded

select-from-sequence-coprime-with-exclude-combinations = coprime wird ignoriert, wil excludeCombinations aagäh isch


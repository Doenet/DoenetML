## `<function>`

# CLDR has no plural rules for `bar`, so the two counts read with one form.
function-domain-insufficient-dimensions = Z weng Dimensiona fia an Definitionsberoach vo da Funktion. Da Beroach hod { $intervals } Intervoi, owa d Funktion hod { $inputs } Eingom.

function-domain-invalid-format = Ungüitigs Format fia an Definitionsberoach vo da Funktion.

function-ignoring-non-numerical =
    { $type ->
        [maximum] Des ned-numerische Maximum vo da Funktion wead ignoriert.
        [minimum] Des ned-numerische Minimum vo da Funktion wead ignoriert.
        [extremum] Des ned-numerische Extremum vo da Funktion wead ignoriert.
        [point] Da ned-numerische Punkt vo da Funktion wead ignoriert.
        [slope] D ned-numerische Steigung vo da Funktion wead ignoriert.
       *[other] Des ned-numerische { $type } vo da Funktion wead ignoriert.
    }

function-ignoring-empty =
    { $type ->
        [maximum] Des leere Maximum vo da Funktion wead ignoriert.
        [minimum] Des leere Minimum vo da Funktion wead ignoriert.
        [extremum] Des leere Extremum vo da Funktion wead ignoriert.
        [point] Da leere Punkt vo da Funktion wead ignoriert.
       *[other] Des leere { $type } vo da Funktion wead ignoriert.
    }

function-points-too-close = D Funktion hod zwoa Punkt, de wo z nah beinanda liegn. D Funktion ko ned definiert wern.

# One form for both counts: CLDR has no plural rules for `bar`.
function-iterates-input-output-mismatch = Iterierte vo ana Funktion san nur meglich, wenn d Ozoi vo de Eingom gleich is wia d Ozoi vo de Ausgom. De Funktion hod { $inputs } Eingom und { $outputs } Ausgom.


prefigure-invalid-width = `<graph>`: ungüitige Braatn fia d prefigure-Umwandlung; es wead d Standard-Diagrammbraatn 425 gnumma.

prefigure-invalid-aspect-ratio = `<graph>`: ungüitigs aspectRatio fia d prefigure-Umwandlung; es wead des Standard-Seitnverhältnis 1 gnumma.

prefigure-grid-spacing-too-fine = `<graph>`: d Gittaweitn is z fei fia d Achsngrenzn; des Gitta wead im prefigure-Renderer weglassn.

prefigure-annotations-not-rendered = `<graph>`: Åmerkunga wern ned dorgstellt, wenn ned da PreFigure-Renderer gnumma wead.

multiple-annotations-children = Es san mehrare `<annotations>`-Kinda im `<graph>` gfundn worn; olle außa's letzte wern ignoriert.


## Style definition contrast

style-definition-insufficient-contrast =
    D Stuidefinition { $styleNumber } hod z weng Kontrast fia { $context ->
        [text-on-background] d Textfarb gegnüba da Hintagrundfarb
        [high-contrast] d Farb mit hohm Kontrast gegnüba da Zeichnfläch
        [line] d Linienfarb gegnüba da Zeichnfläch
        [marker] d Markerfarb gegnüba da Zeichnfläch
       *[text-on-canvas] d Textfarb gegnüba da Zeichnfläch
    }{ $mode ->
        [dark] { " (dunkla Modus)" }
       *[light] { "" }
    } ({ NUMBER($ratio, minimumFractionDigits: 2, maximumFractionDigits: 2) }:1; verlangt mindestns { $threshold }:1).

style-definition-dark-mode-text-background-contrast =
    A wenn d Stuidefinition { $styleNumber } Farbm ogebm hod, de wo im hellen Modus gnua Kontrast hom, hom de drausn obgleitetn Farbm fia an dunklen Modus z weng Kontrast vo da Textfarb gegnüba da Hintagrundfarb ({ NUMBER($ratio, minimumFractionDigits: 2, maximumFractionDigits: 2) }:1; verlangt mindestns { $threshold }:1). { $suggestion ->
        [available] Fia gnua Kontrast im dunklen Modus entweda an Kontrast im hellen Modus erhöhn (z. B. { $lightAttribute }="{ $lightColor }" setzn) oda d Farb fia an dunklen Modus überschreibm (z. B. { $darkAttribute }="{ $darkColor }" setzn).
       *[none] Fia gnua Kontrast im dunklen Modus an Kontrast im hellen Modus erhöhn oda d obgleitetn Farbm mit textColorDarkMode und/oda backgroundColorDarkMode überschreibm.
    }

style-definition-dark-mode-text-canvas-contrast =

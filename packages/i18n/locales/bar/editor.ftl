## The accessibility status button

editor-accessibility-title =
    { $status ->
        [violations] Es is a Verstoß gegn WCAG AA gfundn worn. Klickn, um an Bericht zua Barrierefreiheit { $action ->
            [close] zuazumacha
           *[open] aufzumacha
        }.
        [advisories] Klickn, um an Bericht zua Barrierefreiheit { $action ->
            [close] zuazumacha
           *[open] aufzumacha
        }. Es san koane WCAG-AA-Verstöß gfundn worn, owa es gibt weidare Empfehlunga zua Barrierefreiheit.
       *[clean] Klickn, um an Bericht zua Barrierefreiheit { $action ->
            [close] zuazumacha
           *[open] aufzumacha
        }. Es san koane Problem mit da Barrierefreiheit gfundn worn.
    }

# One form for the count: CLDR has no plural rules for `bar`.
editor-accessibility-label =
    { $status ->
        [violations] Es is a Verstoß gegn WCAG AA gfundn worn. Es san { $count } WCAG-AA-Verstöß gfundn worn. Klickn, um an Bericht zua Barrierefreiheit { $action ->
            [close] zuazumacha
           *[open] aufzumacha
        }.
        [advisories] Es san koane WCAG-AA-Verstöß gfundn worn. Es san { $count } weidare Empfehlunga zua Barrierefreiheit gfundn worn. Klickn, um an Bericht zua Barrierefreiheit { $action ->
            [close] zuazumacha
           *[open] aufzumacha
        }.
       *[clean] Es san koane WCAG-AA-Verstöß gfundn worn. Klickn, um an Bericht zua Barrierefreiheit { $action ->
            [close] zuazumacha
           *[open] aufzumacha
        }.
    }

editor-accessibility-badge = WCAG



# Like German, Bavarian keeps the side count in front of the noun as a
# compound, so the whole thing is one head and there is no tail.
noun-regular-polygon =
    { $part ->
        [tail] { "" }
       *[head] regelmäßigs { $numSides }-Eck
    }
# Besides the nouns above, `$noun` can be `regular-polygon` (which is
# `{ $numSides }-Eck`, neuter) or the head of a phrase the description never
# names: `border` is «da Rand», masculine; `fill` is «d Füllung», feminine;
# `text` is «da Text», masculine; `background` is «da Hintagrund», masculine.
# Three of those four are masculine, which is what the default answers, so
# only `fill` needs a branch of its own.
noun-gender =
    { $noun ->
        [border] m
        [line] f
        [curve] f
        [function] f
        [parabola] f
        [diamond] f
        [fill] f
        [line-segment] f
        [polygon] n
        [triangle] n
        [rectangle] n
        [square] n
        [cross] n
        [plus] n
        [slope-field] n
        [vector-field] n
        [region] m
        [regular-polygon] n
       *[other] m
    }

## Style composition

style-stroke =
    { $parts ->
        [width-style-color] { $width } { $lineStyle } { $color }
        [width-color] { $width } { $color }
        [style-color] { $lineStyle } { $color }
        [width-style] { $width } { $lineStyle }
        [width] { $width }
        [style] { $lineStyle }
       *[color] { $color }
    }
# The adjectives lead and the noun closes the phrase, as in German and in
# English: «dicke gstrichlte rode Linie».
style-with-noun =
    { $parts ->
        [noun-tail] { $description } { $noun } { $nounTail }
       *[noun] { $description } { $noun }
    }
# Only ever said of the shape itself, so it is standalone in every description
# and takes no `$role` branch.
style-filled-word =
    { $gender ->
        [f] gfüllte
        [n] gfüllts
       *[m] gfüllta
    }
style-filled =
    { $parts ->
        [pattern] { $filled } { $color } mit { $pattern }
       *[plain] { $filled } { $color }
    }
style-filled-with-noun =
    { $parts ->
        [pattern] { $filled } { $color } { $noun } mit { $pattern }
        [plain-tail] { $filled } { $color } { $noun } { $nounTail }
        [pattern-tail] { $filled } { $color } { $noun } { $nounTail } mit { $pattern }
       *[plain] { $filled } { $color } { $noun }
    }
# «Rand» is masculine, so the border's adjectives agree with it and not with
# the shape it surrounds. «mit» and «und» govern the dative, which is the
# `border-clause` branch of every adjective — a flat `-n` here, because
# Bavarian has no strong dative `-em` and uses the article instead. Every
# branch therefore takes «am», including the two English leaves the article
# off: a bare dative is not available to write, so keeping the article in all
# four collapses the distinction rather than getting one of them wrong.
style-border-clause =
    { $parts ->
        [with-article] mit am { $border } Rand
        [and] und am { $border } Rand
        [and-article] und am { $border } Rand
       *[with] mit am { $border } Rand
    }
# The fill-pattern words are dative plurals, because their other use is the
# «mit { $pattern }» clause in `style-filled`. So this message supplies a noun
# for them to hang off — «Füllung», feminine, which is the gender `noun-gender`
# answers for `fill`, so the colour agrees with it in both variants.
style-fill =
    { $parts ->
        [pattern] { $color } Füllung mit { $pattern }
       *[plain] { $color } Füllung
    }
style-unfilled = ungfüllt
# «auf am» governs the dative, which is the `background-clause` ending; the
# text colour beside it is predicative, which here is the bare stem. So this
# reads «rod auf am gäibn Hintagrund», where the `textColor` and
# `backgroundColor` variables — the standalone side of the same two words —
# read «roda» and «gäiba».
style-text =
    { $parts ->
        [background] { $color } auf am { $background } Hintagrund
       *[plain] { $color }
    }
style-background-none = koana

